input><input as="in" keep="true">active_light</input><output as="out">word_light_1</output></subrange><formula formula="[1]+0+2*[2]"><input keep="true">rank_light</input><input keep="true">num_channels</input><output>pos_light_2</output></formula><subrange><input as="from" keep="true">pos_light_2</input><input as="length" type="value">1</input><input as="in" keep="true">active_light</input><output as="out">word_light_2</output></subrange><append><input as="in">word_light_0</input><input as="in">word_light_1</input><input as="in">word_light_2</input><output as="out" append="true">light</output></append><count><input as="buffer" keep="true">light</input><output as="count">num_light</output></count><subtract><input as="minuend" keep="true">num_light</input><input as="subtrahend" type="value">1</input><output as="difference">last_light</output></subtract><ramp><input as="start" type="value">0</input><input as="stop" keep="true">last_light</input><input as="length" keep="true">num_light</input><output as="out">idx_light</output></ramp><count><input as="buffer">packet_words</input><output as="count">num_packets</output></count></analysis><views><view label="Sensorauswahl"><toggle label="ⓘ Hilfe anzeigen" default="0"><output>help_view_1</output></toggle><info label="MESSANLEITUNG" visibility="help_view_1" bold="true" color="orange"/><info label="1  VORBEREITEN" visibility="help_view_1" bold="true" color="orange"/><info label="Schalte den Voyager 2 ein und aktiviere Bluetooth am Smartphone." visibility="help_view_1"/><info label="Trenne die Verbindung in PocketLab oder anderen Apps, falls sie bereits auf den Sensor zugreifen." visibility="help_view_1"/><info label="Öffne dieses Experiment in phyphox. Wähle bei einer Geräteabfrage „PL Voyager 2“." visibility="help_view_1"/><info label="2  PHYPHOX-AUFZEICHNUNG AKTIVIEREN" visibility="help_view_1" bold="true" color="orange"/><info label="Tippe oben auf ▶. Damit aktivierst du die Aufzeichnung in phyphox." visibility="help_view_1"/><info label="Der Voyager sendet die ausgewählten Daten erst nach dem Befehl „Messdaten STARTEN“." visibility="help_view_1"/><info label="3  MESSGRÖSSEN AUSWÄHLEN" visibility="help_view_1" bold="true" color="orange"/><info label="Aktiviere die gewünschten Messgrößen mit den Kippschaltern. Mehrere Größen können gleichzeitig gemessen werden." visibility="help_view_1"/><info label="Bewegungssensoren liefern X-, Y- und Z-Komponenten; Umweltgrößen liefern jeweils einen Wert." visibility="help_view_1"/><info label="4  DATENEMPFANG STARTEN" visibility="help_view_1" bold="true" color="orange"/><info label="Tippe einmal auf „Messdaten STARTEN“. Der Voyager überträgt jetzt die ausgewählten Größen." visibility="help_view_1"/><info label="Die Live-Werte und Diagramme findest du in den Reitern „Bewegung“ und „Umgebung“." visibility="help_view_1"/><info label="5  MESSEN ODER AUSWAHL ÄNDERN" visibility="help_view_1" bold="true" color="orange"/><info label="Du kannst zwischen den Reitern wechseln, ohne die Aufzeichnung zu unterbrechen." visibility="help_view_1"/><info label="Für eine neue Sensorauswahl: erst „Messdaten STOPPEN“, dann Schalter ändern und erneut „Messdaten STARTEN“." visibility="help_view_1"/><info label="Bereits gespeicherte Messwerte bleiben dabei erhalten." visibility="help_view_1"/><info label="6  BEENDEN UND SPEICHERN" visibility="help_view_1" bold="true" color="orange"/><info label="Tippe einmal auf „Messdaten STOPPEN“. Pausiere danach die Aufzeichnung oben und wähle:" visibility="help_view_1"/><info label="⋮ → Daten exportieren → CSV → Datei speichern." visibility="help_view_1"/><info label="Das Papierkorb-Symbol löscht deine Messwerte. Verwende es erst nach erfolgreichem Export." visibility="help_view_1"/><info label="WICHTIG: ZWEI UNTERSCHIEDLICHE STEUERUNGEN" visibility="help_view_1" bold="true" color="orange"/><info label="▶/Pause oben: startet oder pausiert die phyphox-Aufzeichnung." visibility="help_view_1"/><info label="„Messdaten STARTEN/STOPPEN“: startet oder stoppt den Voyager-Datenstrom über Bluetooth." visibility="help_view_1"/><info label="Beide müssen aktiv sein, damit neue Messwerte gespeichert werden." visibility="help_view_1"/><info label="Nach einer Bluetooth-Unterbrechung auf die Wiederverbindung warten und erneut „Messdaten STARTEN“ tippen." visibility="help_view_1"/><info label="BEWEGUNG (X/Y/Z)" bold="true" color="FF7100"/><toggle label="Beschleunigung" default="1"><output>sel_acc</output></toggle><toggle label="Winkelgeschwindigkeit" default="1"><output>sel_gyro</output></toggle><toggle label="Magnetfeld" default="0"><output>sel_mag</output></toggle><info label="UMGEBUNG" bold="true" color="FF7100"/><toggle label="Interne Temperatur" default="0"><output>sel_temp</output></toggle><toggle label="Barometrischer Druck" default="0"><output>sel_press</output></toggle><toggle label="Luftfeuchtigkeit" default="0"><output>sel_hum</output></toggle><toggle label="Hitzeindex" default="0"><output>sel_heat</output></toggle><toggle label="Umgebungslichtintensität" default="0"><output>sel_light</output></toggle><info label="MESSUNG STEUERN" bold="true" color="FF7100"/><button label="Messdaten STARTEN"><input type="value">1</input><input type="empty"/><output>last_action</output><output>warmup_seen_packet</output><trigger>apply_selection</trigger></button><button label="Messdaten STOPPEN"><input type="value">0</input><output>last_action</output><trigger>all_stop</trigger></button></view><view label="Bewegung">
      <toggle label="ⓘ Hilfe anzeigen" default="0"><output>help_view_2</output></toggle><info label="BEWEGUNG: MESSGRÖSSEN UND EINHEITEN" visibility="help_view_2" bold="true" color="orange"/><info label="Beschleunigung (Acceleration):" visibility="help_view_2" bold="true"/><info label="X-, Y- und Z-Komponente in m/s². Der Beschleunigungssensor misst spezifische Kraft. Im Ruhezustand zeigt die nach oben gerichtete Achse typischerweise etwa +9,81 m/s²." visibility="help_view_2"/><info label="Winkelgeschwindigkeit (Angular Velocity):" visibility="help_view_2" bold="true"/><info label="X-, Y- und Z-Komponente in rad/s. Das Vorzeichen einer Drehung folgt der Rechte-Hand-Regel." visibility="help_view_2"/><info label="Magnetfeld (Magnetic Field):" visibility="help_view_2" bold="true"/><info label="Magnetische Flussdichte entlang X, Y und Z in µT. Die Komponenten hängen von der Orientierung des Sensors im Magnetfeld ab." visibility="help_view_2"/><info label="KOORDINATENSYSTEM UND FARBEN" visibility="help_view_2" bold="true" color="orange"/><info label="Die Pfeile auf der LED-Seite definieren die Achsen. Mit den Pfeilen aufrecht: +X nach rechts, +Y nach oben und +Z senkrecht aus der LED-Seite heraus." visibility="help_view_2"/><info label="In allen XYZ-Diagrammen gilt: X = Rot, Y = Blau, Z = Grün." visibility="help_view_2"/><info label="Negative Werte kennzeichnen die entgegengesetzte Achsen- beziehungsweise Drehrichtung." visibility="help_view_2"/><info label="EINHEITEN UND UMRECHNUNG" visibility="help_view_2" bold="true" color="orange"/><info label="Anzeige und CSV-Export verwenden m/s² und rad/s. Die ursprünglichen BLE-Werte liegen in g₀ und °/s vor." visibility="help_view_2"/><info label="1 g₀ = 9,80665 m/s²." visibility="help_view_2"/><info label="1 °/s = π/180 rad/s ≈ 0,0174533 rad/s. 1 µT = 10⁻⁶ T." visibility="help_view_2"/><info label="ZEITACHSE" visibility="help_view_2" bold="true" color="orange"/><info label="Die X-Achse zeigt die geschätzte Zeit in Sekunden seit dem Experimentstart. Grundlage sind Bluetooth-Empfangszeiten und eine angenommene Datenrate von etwa 20 Hz." visibility="help_view_2"/><info label="Messpausen bleiben als Lücken sichtbar. Die Zeitwerte sind keine Zeitstempel aus dem Sensor." visibility="help_view_2"/><value label="Beschleunigung X" unit="m/s²" precision="3" color="red" visibility="sel_acc">
        <input>ax</input>
      </value>
      <value label="Beschleunigung Y" unit="m/s²" precision="3" color="blue" visibility="sel_acc">
        <input>ay</input>
      </value>
      <value label="Beschleunigung Z" unit="m/s²" precision="3" color="green" visibility="sel_acc">
        <input>az</input>
      </value>
      <graph label="Beschleunigung" labelX="Zeit" labelY="Beschleunigung" unitY="m/s²" partialUpdate="false" visibility="sel_acc" unitX="s" timeOnX="true">
        <input axis="x">t_acc</input>
        <input axis="y" color="red">ax</input>
        <input axis="x">t_acc</input>
        <input axis="y" color="blue">ay</input>
        <input axis="x">t_acc</input>
        <input axis="y" color="green">az</input>
      </graph>
      <value label="Winkelgeschwindigkeit X" unit="rad/s" precision="4" color="red" visibility="sel_gyro">
        <input>wx</input>
      </value>
      <value label="Winkelgeschwindigkeit Y" unit="rad/s" precision="4" color="blue" visibility="sel_gyro">
        <input>wy</input>
      </value>
      <value label="Winkelgeschwindigkeit Z" unit="rad/s" precision="4" color="green" visibility="sel_gyro">
        <input>wz</input>
      </value>
      <graph label="Winkelgeschwindigkeit" labelX="Zeit" labelY="Winkelgeschwindigkeit" unitY="rad/s" partialUpdate="false" visibility="sel_gyro" unitX="s" timeOnX="true">
        <input axis="x">t_gyro</input>
        <input axis="y" color="red">wx</input>
        <input axis="x">t_gyro</input>
        <input axis="y" color="blue">wy</input>
        <input axis="x">t_gyro</input>
        <input axis="y" color="green">wz</input>
      </graph>
      <value label="Magnetfeld X" unit="µT" precision="3" color="red" visibility="sel_mag">
        <input>bx</input>
      </value>
      <value label="Magnetfeld Y" unit="µT" precision="3" color="blue" visibility="sel_mag">
        <input>by</input>
      </value>
      <value label="Magnetfeld Z" unit="µT" precision="3" color="green" visibility="sel_mag">
        <input>bz</input>
      </value>
      <graph label="Magnetfeld" labelX="Zeit" labelY="Magnetfeld" unitY="µT" partialUpdate="false" visibility="sel_mag" unitX="s" timeOnX="true">
        <input axis="x">t_mag</input>
        <input axis="y" color="red">bx</input>
        <input axis="x">t_mag</input>
        <input axis="y" color="blue">by</input>
        <input axis="x">t_mag</input>
        <input axis="y" color="green">bz</input>
      </graph>
    </view>
    <view label="Umgebung">
      <toggle label="ⓘ Hilfe anzeigen" default="0"><output>help_view_3</output></toggle><info label="UMGEBUNG: MESSGRÖSSEN UND EINHEITEN" visibility="help_view_3" bold="true" color="orange"/><info label="Interne Temperatur (Internal Temperature):" visibility="help_view_3" bold="true"/><info label="Gemessen in °C. Der Sensor erfasst die Temperatur im Gerät; sie muss nicht der Raumtemperatur entsprechen." visibility="help_view_3"/><info label="Barometrischer Druck (Pressure Barometric):" visibility="help_view_3" bold="true"/><info label="Angezeigt in hPa und als Pa exportiert. 1 hPa = 100 Pa." visibility="help_view_3"/><info label="Luftfeuchtigkeit (Humidity):" visibility="help_view_3" bold="true"/><info label="Gemessen als relative Luftfeuchtigkeit in %. 40 % bedeutet 40 % relative Feuchte, nicht 40 % Wasserdampfanteil am Luftvolumen." visibility="help_view_3"/><info label="Hitzeindex (Heat Index):" visibility="help_view_3" bold="true"/><info label="Angegeben in °C. Der Hitzeindex ist ein aus Umgebungsbedingungen abgeleiteter Wert, kein weiterer direkter Temperatursensor." visibility="help_view_3"/><info label="Umgebungslichtintensität (Ambient Light Intensity):" visibility="help_view_3" bold="true"/><info label="Gemessen in lx (Lux). Der Messwert beschreibt die am Sensor auftreffende Beleuchtungsstärke." visibility="help_view_3"/><info label="MESSWERTE LESEN" visibility="help_view_3" bold="true" color="orange"/><info label="Wenn du eine Umweltgröße im Reiter „Sensorauswahl“ aktivierst und „Messdaten STARTEN“ drückst, wird sie hier angezeigt." visibility="help_view_3"/><info label="Zu jeder gewählten Größe siehst du einen Live-Wert (den zuletzt empfangenen Messwert) und darunter ein Diagramm über die Zeit." visibility="help_view_3"/><info label="Nicht ausgewählte Größen bleiben ausgeblendet und erhalten keine neuen Messwerte." visibility="help_view_3"/><info label="DATENQUALITÄT UND ZEIT" visibility="help_view_3" bold="true" color="orange"/><info label="Nach jedem START wird das erste vollständige Umwelt-Datenpaket übersprungen, weil frühere Versuche einzelne unplausible Anfangswerte zeigten." visibility="help_view_3"/><info label="Spätere Einschwingvorgänge sind weiterhin möglich. Das Überspringen ist keine Kalibrierung." visibility="help_view_3"/><info label="Die X-Achse zeigt geschätzte Sekunden seit Experimentbeginn. Messpausen erscheinen als Lücken." visibility="help_view_3"/><value label="Interne Temperatur" unit="°C" precision="2" color="orange" visibility="sel_temp">
        <input>temp</input>
      </value>
      <graph label="Interne Temperatur" labelX="Zeit" labelY="Interne Temperatur" unitY="°C" partialUpdate="false" visibility="sel_temp" unitX="s" timeOnX="true">
        <input axis="x">t_temp</input>
        <input axis="y" color="orange">temp</input>
      </graph>
      <value label="Barometrischer Druck" unit="hPa" precision="2" color="orange" visibility="sel_press">
        <input>pressure_hpa</input>
      </value>
      <graph label="Barometrischer Druck" labelX="Zeit" labelY="Barometrischer Druck" unitY="hPa" partialUpdate="false" visibility="sel_press" unitX="s" timeOnX="true">
        <input axis="x">t_press</input>
        <input axis="y" color="orange">pressure_hpa</input>
      </graph>
      <value label="Luftfeuchtigkeit" unit="%" precision="2" color="orange" visibility="sel_hum">
        <input>humidity</input>
      </value>
      <graph label="Luftfeuchtigkeit" labelX="Zeit" labelY="Luftfeuchtigkeit" unitY="%" partialUpdate="false" visibility="sel_hum" unitX="s" timeOnX="true">
        <input axis="x">t_hum</input>
        <input axis="y" color="orange">humidity</input>
      </graph>
      <value label="Hitzeindex" unit="°C" precision="2" color="orange" visibility="sel_heat">
        <input>heat</input>
      </value>
      <graph label="Hitzeindex" labelX="Zeit" labelY="Hitzeindex" unitY="°C" partialUpdate="false" visibility="sel_heat" unitX="s" timeOnX="true">
        <input axis="x">t_heat</input>
        <input axis="y" color="orange">heat</input>
      </graph>
      <value label="Umgebungslichtintensität" unit="lx" precision="2" color="orange" visibility="sel_light">
        <input>light</input>
      </value>
      <graph label="Umgebungslichtintensität" labelX="Zeit" labelY="Umgebungslichtintensität" unitY="lx" partialUpdate="false" visibility="sel_light" unitX="s" timeOnX="true">
        <input axis="x">t_light</input>
        <input axis="y" color="orange">light</input>
      </graph>
    </view>
    <view label="Status"><toggle label="ⓘ Hilfe anzeigen" default="0"><output>help_view_4</output></toggle><info label="STATUS: WAS BEDEUTEN DIE ZAHLEN?" visibility="help_view_4" bold="true" color="orange"/><info label="„Letzte Aktion“: 1 steht für START, 0 für STOPP, −1 für noch keinen Befehl. Diese Anzeige bestätigt den Tastendruck, nicht die Antwort des Sensors." visibility="help_view_4"/><info label="„Ausgewählte Datenkanäle“ zählt einzelne Zahlenkanäle; Beschleunigung, Gyroskop und Magnetfeld belegen jeweils drei, die Umweltgrößen jeweils einen." visibility="help_view_4"/><info label="„Erwartete Float32-Werte/Paket“ zeigt die für die ausgewählte Sensorkombination erwartete Anzahl. „Empfangene Float32-Werte/Paket“ hilft bei der Paketanalyse." visibility="help_view_4"/><info label="„Startfilter“ zeigt, ob das erste Umweltpaket registriert wurde. Die Sample-Zähler zeigen, wie viele Messwerte bisher für eine Größe angekommen sind." visibility="help_view_4"/><info label="PROBLEME BEHEBEN" visibility="help_view_4" bold="true" color="orange"/><info label="KEINE KURVE?" visibility="help_view_4" bold="true"/><info label="1. Prüfe, ob die phyphox-Aufzeichnung oben über ▶ gestartet wurde." visibility="help_view_4"/><info label="2. Aktiviere mindestens eine Messgröße in „Sensorauswahl“." visibility="help_view_4"/><info label="3. Tippe auf „Messdaten STARTEN“." visibility="help_view_4"/><separator height="0.7" visibility="help_view_4"/><info label="BLUETOOTH-VERBINDUNG ABGEBROCHEN?" visibility="help_view_4" bold="true"/><info label="1. Aktiviere Bluetooth am Smartphone erneut." visibility="help_view_4"/><info label="2. Warte, bis phyphox den Voyager 2 wieder verbunden hat." visibility="help_view_4"/><info label="3. Tippe erneut auf „Messdaten STARTEN“." visibility="help_view_4"/><separator height="0.7" visibility="help_view_4"/><info label="KEINE VERBINDUNG ZUM SENSOR?" visibility="help_view_4" bold="true"/><info label="1. Stelle sicher, dass der Voyager 2 eingeschaltet ist." visibility="help_view_4"/><info label="2. Trenne eine aktive Verbindung mit PocketLab oder einer anderen Bluetooth-App." visibility="help_view_4"/><info label="3. Öffne das phyphox-Experiment bei Bedarf neu." visibility="help_view_4"/><separator height="0.7" visibility="help_view_4"/><info label="UNERWARTETE ODER EXTREME MESSWERTE?" visibility="help_view_4" bold="true"/><info label="Prüfe zuerst, ob die richtige Messgröße aktiviert ist." visibility="help_view_4"/><info label="Beim Wechsel der Sensoren werden alte BLE-Pakete verworfen. Einzelne Einschwingwerte können dennoch auftreten." visibility="help_view_4"/><separator height="0.7" visibility="help_view_4"/><info label="„NaN“ IM CSV-EXPORT?" visibility="help_view_4" bold="true"/><info label="Das ist bei Messkanälen mit unterschiedlich vielen Werten normal. Kürzere Datenreihen werden in der gemeinsamen CSV-Tabelle mit NaN aufgefüllt." visibility="help_view_4"/><info label="Verwende für die zeitliche Zuordnung die jeweilige Zeitspalte des Sensors." visibility="help_view_4"/><info label="ZEIT- UND EINHEITENHINWEIS" visibility="help_view_4" bold="true" color="orange"/><info label="Die Zeitwerte sind aus BLE-Empfangszeiten angenähert und monotonisiert. Unterbrechungen werden nicht mit erfundenen Werten aufgefüllt. Für präzise Timing-Experimente ist diese Schätzung nicht als Gerätezeit zu verwenden." visibility="help_view_4"/><info label="Die Anzeige nutzt überwiegend SI-Einheiten. Beschleunigung wurde aus g in m/s² und Winkelgeschwindigkeit aus °/s in rad/s umgerechnet." visibility="help_view_4"/><value label="Letzte Aktion: 1=Start, 0=Stopp" precision="0"><input>last_action</input></value><value label="Ausgewählte Datenkanäle" precision="0"><input>num_channels</input></value><value label="Erwartete Float32-Werte/Paket" precision="0"><input>expected_words</input></value><value label="Startfilter: 0=wartet, 1=erstes Paket erkannt" precision="0"><input>warmup_count_after</input></value><value label="Empfangene Float32-Werte/Paket" precision="0"><input>packet_word_count</input></value><value label="Werte Beschleunigung" precision="0"><input>num_acc</input></value><value label="Werte Winkelgeschwindigkeit" precision="0"><input>num_gyro</input></value><value label="Werte Magnetfeld" precision="0"><input>num_mag</input></value><value label="Werte Interne Temperatur" precision="0"><input>num_temp</input></value></view></views><export>
    <set name="Voyager 2 – Alle Messwerte (14 Kanäle)">
      <data name="Beschleunigung – Zeit (s, geschätzt)">t_acc</data><data name="Beschleunigung X (m/s²)">ax</data>
      <data name="Beschleunigung Y (m/s²)">ay</data>
      <data name="Beschleunigung Z (m/s²)">az</data>
      <data name="Winkelgeschwindigkeit – Zeit (s, geschätzt)">t_gyro</data><data name="Winkelgeschwindigkeit X (rad/s)">wx</data>
      <data name="Winkelgeschwindigkeit Y (rad/s)">wy</data>
      <data name="Winkelgeschwindigkeit Z (rad/s)">wz</data>
      <data name="Magnetfeld – Zeit (s, geschätzt)">t_mag</data><data name="Magnetfeld X (µT)">bx</data>
      <data name="Magnetfeld Y (µT)">by</data>
      <data name="Magnetfeld Z (µT)">bz</data>
      <data name="Interne Temperatur – Zeit (s, geschätzt)">t_temp</data><data name="Interne Temperatur (°C)">temp</data>
      <data name="Barometrischer Druck – Zeit (s, geschätzt)">t_press</data><data name="Barometrischer Druck (Pa)">press</data>
      <data name="Luftfeuchtigkeit – Zeit (s, geschätzt)">t_hum</data><data name="Luftfeuchtigkeit (%)">humidity</data>
      <data name="Hitzeindex – Zeit (s, geschätzt)">t_heat</data><data name="Hitzeindex (°C)">heat</data>
      <data name="Umgebungslichtintensität – Zeit (s, geschätzt)">t_light</data><data name="Umgebungslichtintensität (lx)">light</data>
    </set>
  </export>
</phyphox>
