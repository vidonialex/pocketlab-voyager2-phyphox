      <input as="from" keep="true">pos_humidity_1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_hum</input>
      <output as="out">word_humidity_1</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_humidity_2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_hum</input>
      <output as="out">word_humidity_2</output>
    </subrange>
    <append>
      <input as="in">word_humidity_0</input>
      <input as="in">word_humidity_1</input>
      <input as="in">word_humidity_2</input>
      <output as="out" append="true">humidity</output>
    </append>
    <if equal="true">
      <input as="a" keep="true">sel_heat</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">env_ready_words</input>
      <input as="false" type="empty" />
      <output as="result">active_heat</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">sel_heat</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">rx_env_triplet</input>
      <input as="false" type="empty" />
      <output as="result">rx_new_heat</output>
    </if>
    <append>
      <input as="in">rx_new_heat</input>
      <output as="out" append="true">t_heat</output>
    </append>
    <subrange>
      <input as="from" keep="true">pos_heat_0</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_heat</input>
      <output as="out">word_heat_0</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_heat_1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_heat</input>
      <output as="out">word_heat_1</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_heat_2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_heat</input>
      <output as="out">word_heat_2</output>
    </subrange>
    <append>
      <input as="in">word_heat_0</input>
      <input as="in">word_heat_1</input>
      <input as="in">word_heat_2</input>
      <output as="out" append="true">heat</output>
    </append>
    <if equal="true">
      <input as="a" keep="true">sel_ir</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">valid_packet_words</input>
      <input as="false" type="empty" />
      <output as="result">active_ir</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">sel_ir</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">rx_valid_triplet</input>
      <input as="false" type="empty" />
      <output as="result">rx_new_ir</output>
    </if>
    <append>
      <input as="in">rx_new_ir</input>
      <output as="out" append="true">t_ir</output>
    </append>
    <subrange>
      <input as="from" keep="true">pos_ir_0</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_ir</input>
      <output as="out">word_ir_0</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_ir_1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_ir</input>
      <output as="out">word_ir_1</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_ir_2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_ir</input>
      <output as="out">word_ir_2</output>
    </subrange>
    <append>
      <input as="in">word_ir_0</input>
      <input as="in">word_ir_1</input>
      <input as="in">word_ir_2</input>
      <output as="out" append="true">ir</output>
    </append>
    <if equal="true">
      <input as="a" keep="true">sel_light</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">env_ready_words</input>
      <input as="false" type="empty" />
      <output as="result">active_light</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">sel_light</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">rx_env_triplet</input>
      <input as="false" type="empty" />
      <output as="result">rx_new_light</output>
    </if>
    <append>
      <input as="in">rx_new_light</input>
      <output as="out" append="true">t_light</output>
    </append>
    <subrange>
      <input as="from" keep="true">pos_light_0</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_light</input>
      <output as="out">word_light_0</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_light_1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_light</input>
      <output as="out">word_light_1</output>
    </subrange>
    <subrange>
      <input as="from" keep="true">pos_light_2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">active_light</input>
      <output as="out">word_light_2</output>
    </subrange>
    <append>
      <input as="in">word_light_0</input>
      <input as="in">word_light_1</input>
      <input as="in">word_light_2</input>
      <output as="out" append="true">light</output>
    </append>
    <count>
      <input as="buffer">packet_words</input>
      <output as="count">num_packets</output>
    </count>
    <count>
      <input as="buffer" keep="true">ax</input>
      <output as="count">num_acc</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_acc</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_acc</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_acc</input>
      <input as="length" keep="true">num_acc</input>
      <output as="out">idx_acc</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">wx</input>
      <output as="count">num_gyro</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_gyro</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_gyro</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_gyro</input>
      <input as="length" keep="true">num_gyro</input>
      <output as="out">idx_gyro</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">bx</input>
      <output as="count">num_mag</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_mag</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_mag</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_mag</input>
      <input as="length" keep="true">num_mag</input>
      <output as="out">idx_mag</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">probe</input>
      <output as="count">num_probe</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_probe</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_probe</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_probe</input>
      <input as="length" keep="true">num_probe</input>
      <output as="out">idx_probe</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">temp</input>
      <output as="count">num_temp</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_temp</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_temp</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_temp</input>
      <input as="length" keep="true">num_temp</input>
      <output as="out">idx_temp</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">press</input>
      <output as="count">num_press</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_press</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_press</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_press</input>
      <input as="length" keep="true">num_press</input>
      <output as="out">idx_press</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">humidity</input>
      <output as="count">num_hum</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_hum</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_hum</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_hum</input>
      <input as="length" keep="true">num_hum</input>
      <output as="out">idx_hum</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">heat</input>
      <output as="count">num_heat</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_heat</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_heat</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_heat</input>
      <input as="length" keep="true">num_heat</input>
      <output as="out">idx_heat</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">ir</input>
      <output as="count">num_ir</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_ir</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_ir</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_ir</input>
      <input as="length" keep="true">num_ir</input>
      <output as="out">idx_ir</output>
    </ramp>
    <count>
      <input as="buffer" keep="true">light</input>
      <output as="count">num_light</output>
    </count>
    <subtract>
      <input as="minuend" keep="true">num_light</input>
      <input as="subtrahend" type="value">1</input>
      <output as="difference">last_light</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" keep="true">last_light</input>
      <input as="length" keep="true">num_light</input>
      <output as="out">idx_light</output>
    </ramp>
  </analysis>
  <views>
    <view label="Sensorauswahl">
      <info label="Empfohlen: Sensoren wählen → Aufzeichnung mit ▶ (oben rechts) starten → „Messdaten STARTEN“." bold="true" color="orange" />
      <toggle label="ⓘ Hilfe anzeigen" default="0">
        <output>help_view_1</output>
      </toggle>
      <info label="MESSANLEITUNG" visibility="help_view_1" bold="true" color="orange" />
      <info label="1  VORBEREITEN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Schalte den Voyager 2 ein und aktiviere Bluetooth am Smartphone." visibility="help_view_1" />
      <info label="Trenne die Verbindung in PocketLab oder anderen Apps, falls sie bereits auf den Sensor zugreifen." visibility="help_view_1" />
      <info label="Öffne dieses Experiment in phyphox und verbinde den Voyager 2 über Bluetooth. Bei nummerierten Geräten den passenden Namen „PL Voyager 2-01“ oder „PL Voyager 2-02“ wählen." visibility="help_view_1" />
      <info label="2  MESSGRÖSSEN AUSWÄHLEN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Aktiviere die gewünschten Messgrößen mit den Kippschaltern. Mehrere Größen können gleichzeitig gemessen werden." visibility="help_view_1" />
      <info label="Bewegungssensoren liefern X-, Y- und Z-Komponenten; Umweltgrößen liefern jeweils einen Wert." visibility="help_view_1" />
      <info label="3  PHYPHOX-AUFZEICHNUNG AKTIVIEREN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Nach der Sensorauswahl: Tippe oben rechts auf ▶. Damit startest du die phyphox-Aufzeichnung." visibility="help_view_1" />
      <info label="Bei jedem Messstart und Wiederaufnehmen empfehlen wir zuerst ▶, danach „Messdaten STARTEN“." visibility="help_view_1" />
      <info label="4  DATENEMPFANG STARTEN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Empfohlener Ablauf: nach ▶ oben rechts „Messdaten STARTEN“ antippen. Diesen Ablauf auch nach einer Pause verwenden." visibility="help_view_1" />
      <info label="Die Live-Werte und Diagramme findest du in den Reitern „Bewegung“ und „Umgebung“." visibility="help_view_1" />
      <info label="5  MESSEN ODER AUSWAHL ÄNDERN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Du kannst zwischen den Reitern wechseln, ohne die Aufzeichnung zu unterbrechen." visibility="help_view_1" />
      <info label="Empfohlener Sensorwechsel: „Messdaten STOPPEN“, neue Sensoren auswählen, wieder „Messdaten STARTEN“. Die phyphox-Aufzeichnung dabei aktiv lassen; falls pausiert, auch wieder ▶ starten." visibility="help_view_1" />
      <info label="Bereits gespeicherte Messwerte bleiben dabei erhalten." visibility="help_view_1" />
      <info label="6  BEENDEN" visibility="help_view_1" bold="true" color="orange" />
      <info label="Zum Beenden erst „Messdaten STOPPEN“ antippen, danach phyphox oben rechts pausieren." visibility="help_view_1" />
      <info label="7  EXPORTIEREN" visibility="help_view_1" bold="true" color="orange" />
      <info label="⋮ → Daten exportieren → CSV → speichern/teilen." visibility="help_view_1" />
      <info label="Das Papierkorb-Symbol löscht deine Messwerte. Verwende es erst nach erfolgreichem Export." visibility="help_view_1" />
      <info label="WICHTIG: ZWEI UNTERSCHIEDLICHE STEUERUNGEN" visibility="help_view_1" bold="true" color="orange" />
      <info label="▶/Pause oben: startet oder pausiert die phyphox-Aufzeichnung." visibility="help_view_1" />
      <info label="„Messdaten STARTEN/STOPPEN“: startet oder stoppt den Voyager-Datenstrom über Bluetooth." visibility="help_view_1" />
      <info label="STARTEN vor ▶ funktionierte beim erstmaligen Messstart, nach dem Pausieren und Wiederaufnehmen jedoch nicht zuverlässig. Die Ursache ist nicht abschließend geklärt. Deshalb empfehlen wir immer ▶ → „Messdaten STARTEN“." visibility="help_view_1" />
      <info label="Nach einer Bluetooth-Unterbrechung auf die Wiederverbindung warten. Falls phyphox pausiert ist, empfehlen wir ▶ oben rechts und danach erneut „Messdaten STARTEN“." visibility="help_view_1" />
      <info label="BEWEGUNG (X/Y/Z)" bold="true" color="FF7100" />
      <toggle label="Beschleunigung" default="1">
        <output>sel_acc</output>
      </toggle>
      <toggle label="Winkelgeschwindigkeit" default="1">
        <output>sel_gyro</output>
      </toggle>
      <toggle label="Magnetfeld" default="0">
        <output>sel_mag</output>
      </toggle>
      <info label="UMGEBUNG" bold="true" color="FF7100" />
      <toggle label="Externe Temperatursonde" default="0">
        <output>sel_probe</output>
      </toggle>
      <toggle label="Interne Temperatur" default="0">
        <output>sel_temp</output>
      </toggle>
      <toggle label="Barometrischer Druck" default="0">
        <output>sel_press</output>
      </toggle>
      <toggle label="Luftfeuchtigkeit" default="0">
        <output>sel_hum</output>
      </toggle>
      <toggle label="Hitzeindex" default="0">
        <output>sel_heat</output>
      </toggle>
      <toggle label="Umgebungslichtintensität" default="0">
        <output>sel_light</output>
      </toggle>
      <toggle label="IR-Entfernung" default="0">
        <output>sel_ir</output>
      </toggle>
      <info label="MESSUNG STEUERN" bold="true" color="FF7100" />
      <button label="Messdaten STARTEN">
        <input type="value">1</input>
        <input type="empty" />
        <output>last_action</output>
        <output>warmup_seen_packet</output>
        <trigger>apply_selection</trigger>
        <input type="empty" />
        <output>rx_words</output>
        <input type="empty" />
        <output>pending_words</output>
        <input type="empty" />
        <output>rx_h0</output>
        <input type="empty" />
        <output>pending_h0</output>
        <input type="empty" />
        <output>rx_h1</output>
        <input type="empty" />
        <output>pending_h1</output>
        <input type="empty" />
        <output>rx_h2</output>
        <input type="empty" />
        <output>pending_h2</output>
        <input type="empty" />
        <output>rx_h3</output>
        <input type="empty" />
        <output>pending_h3</output>
        <input type="empty" />
        <output>rx_h4</output>
        <input type="empty" />
        <output>pending_h4</output>
        <input type="empty" />
        <output>rx_h5</output>
        <input type="empty" />
        <output>pending_h5</output>
        <input type="empty" />
        <output>rx_times</output>
        <input type="empty" />
        <output>pending_times</output>
      </button>
      <button label="Messdaten STOPPEN">
        <input type="value">0</input>
        <output>last_action</output>
        <trigger>all_stop</trigger>
      </button>
    </view>
    <view label="Bewegung">
      <toggle label="ⓘ Hilfe anzeigen" default="0">
        <output>help_view_2</output>
      </toggle>
      <info label="BEWEGUNG: MESSGRÖSSEN UND EINHEITEN" visibility="help_view_2" bold="true" color="orange" />
      <info label="Beschleunigung (Acceleration):" visibility="help_view_2" bold="true" />
      <info label="X-, Y- und Z-Komponente in m/s². Der Beschleunigungssensor misst spezifische Kraft. Im Ruhezustand zeigt die nach oben gerichtete Achse typischerweise etwa +9,81 m/s²." visibility="help_view_2" />
      <info label="Winkelgeschwindigkeit (Angular Velocity):" visibility="help_view_2" bold="true" />
      <info label="X-, Y- und Z-Komponente in rad/s. Das Vorzeichen einer Drehung folgt der Rechte-Hand-Regel." visibility="help_view_2" />
      <info label="Magnetfeld (Magnetic Field):" visibility="help_view_2" bold="true" />
      <info label="Magnetische Flussdichte entlang X, Y und Z in µT. Die Komponenten hängen von der Orientierung des Sensors im Magnetfeld ab." visibility="help_view_2" />
      <info label="KOORDINATENSYSTEM UND FARBEN" visibility="help_view_2" bold="true" color="orange" />
      <info label="Die Pfeile auf der LED-Seite definieren die Achsen. Mit den Pfeilen aufrecht: +X nach rechts, +Y nach oben und +Z senkrecht aus der LED-Seite heraus." visibility="help_view_2" />
      <info label="In allen XYZ-Diagrammen gilt: X = Rot, Y = Blau, Z = Grün." visibility="help_view_2" />
      <info label="Negative Werte kennzeichnen die entgegengesetzte Achsen- beziehungsweise Drehrichtung." visibility="help_view_2" />
      <info label="EINHEITEN UND UMRECHNUNG" visibility="help_view_2" bold="true" color="orange" />
      <info label="Anzeige und CSV-Export verwenden m/s² und rad/s. Die ursprünglichen BLE-Werte liegen in g₀ und °/s vor." visibility="help_view_2" />
      <info label="1 g₀ = 9,80665 m/s²." visibility="help_view_2" />
      <info label="1 °/s = π/180 rad/s ≈ 0,0174533 rad/s. 1 µT = 10⁻⁶ T." visibility="help_view_2" />
      <info label="ZEITACHSE" visibility="help_view_2" bold="true" color="orange" />
      <info label="Die X-Achse zeigt die geschätzte Zeit in Sekunden seit dem Experimentstart. Grundlage sind Bluetooth-Empfangszeiten und eine angenommene Datenrate von etwa 20 Hz." visibility="help_view_2" />
      <info label="Messpausen bleiben als Lücken sichtbar. Die Zeitwerte sind keine Zeitstempel aus dem Sensor." visibility="help_view_2" />
      <value label="Beschleunigung X" unit="m/s²" precision="3" color="red" visibility="sel_acc">
        <input>ax</input>
      </value>
      <value label="Beschleunigung Y" unit="m/s²" precision="3" color="blue" visibility="sel_acc">
        <input>ay</input>
      </value>
      <value label="Beschleunigung Z" unit="m/s²" precision="3" color="green" visibility="sel_acc">
        <input>az</input>
      </value>
      <graph label="Beschleunigung" labelX="Zeit" labelY="Beschleunigung" unitY="m/s²" partialUpdate="false" visibility="sel_acc" unitX="s" timeOnX="true">
        <input axis="x">t_acc</input>
        <input axis="y" color="red">ax</input>
        <input axis="x">t_acc</input>
        <input axis="y" color="blue">ay</input>
        <input axis="x">t_acc</input>
        <input axis="y" color="green">az</input>
      </graph>
      <value label="Winkelgeschwindigkeit X" unit="rad/s" precision="4" color="red" visibility="sel_gyro">
        <input>wx</input>
      </value>
      <value label="Winkelgeschwindigkeit Y" unit="rad/s" precision="4" color="blue" visibility="sel_gyro">
        <input>wy</input>
      </value>
      <value label="Winkelgeschwindigkeit Z" unit="rad/s" precision="4" color="green" visibility="sel_gyro">
        <input>wz</input>
      </value>
      <graph label="Winkelgeschwindigkeit" labelX="Zeit" labelY="Winkelgeschwindigkeit" unitY="rad/s" partialUpdate="false" visibility="sel_gyro" unitX="s" timeOnX="true">
        <input axis="x">t_gyro</input>
        <input axis="y" color="red">wx</input>
        <input axis="x">t_gyro</input>
        <input axis="y" color="blue">wy</input>
        <input axis="x">t_gyro</input>
        <input axis="y" color="green">wz</input>
      </graph>
      <value label="Magnetfeld X" unit="µT" precision="3" color="red" visibility="sel_mag">
        <input>bx</input>
      </value>
      <value label="Magnetfeld Y" unit="µT" precision="3" color="blue" visibility="sel_mag">
        <input>by</input>
      </value>
      <value label="Magnetfeld Z" unit="µT" precision="3" color="green" visibility="sel_mag">
        <input>bz</input>
      </value>
      <graph label="Magnetfeld" labelX="Zeit" labelY="Magnetfeld" unitY="µT" partialUpdate="false" visibility="sel_mag" unitX="s" timeOnX="true">
        <input axis="x">t_mag</input>
        <input axis="y" color="red">bx</input>
        <input axis="x">t_mag</input>
        <input axis="y" color="blue">by</input>
        <input axis="x">t_mag</input>
        <input axis="y" color="green">bz</input>
      </graph>
    </view>
    <view label="Umgebung">
      <toggle label="ⓘ Hilfe anzeigen" default="0">
        <output>help_view_3</output>
      </toggle>
      <info label="UMGEBUNG: MESSGRÖSSEN UND EINHEITEN" visibility="help_view_3" bold="true" color="orange" />
      <info label="Externe Temperatursonde (Temperature Probe):" visibility="help_view_3" bold="true" />
      <info label="Die externe Sonde muss am Voyager 2 angeschlossen sein. Die Anzeige erfolgt in °C. Eine Kalibrierung mit einer Referenztemperatur steht noch aus." visibility="help_view_3" />
      <info label="Interne Temperatur (Internal Temperature):" visibility="help_view_3" bold="true" />
      <info label="Gemessen in °C. Der Sensor erfasst die Temperatur im Gerät; sie muss nicht der Raumtemperatur entsprechen." visibility="help_view_3" />
      <info label="Barometrischer Druck (Pressure Barometric):" visibility="help_view_3" bold="true" />
      <info label="Angezeigt in hPa und als Pa exportiert. 1 hPa = 100 Pa." visibility="help_view_3" />
      <info label="Luftfeuchtigkeit (Humidity):" visibility="help_view_3" bold="true" />
      <info label="Gemessen als relative Luftfeuchtigkeit in %. 40 % bedeutet 40 % relative Feuchte, nicht 40 % Wasserdampfanteil am Luftvolumen." visibility="help_view_3" />
      <info label="Hitzeindex (Heat Index):" visibility="help_view_3" bold="true" />
      <info label="Angegeben in °C. Der Hitzeindex ist ein aus Umgebungsbedingungen abgeleiteter Wert, kein weiterer direkter Temperatursensor." visibility="help_view_3" />
      <info label="Umgebungslichtintensität (Ambient Light Intensity):" visibility="help_view_3" bold="true" />
      <info label="Gemessen in lx (Lux). Der Messwert beschreibt die am Sensor auftreffende Beleuchtungsstärke." visibility="help_view_3" />
      <info label="MESSWERTE LESEN" visibility="help_view_3" bold="true" color="orange" />
      <info label="Umweltgröße unter „Sensorauswahl“ wählen, ▶ oben rechts starten und danach „Messdaten STARTEN“ antippen. Dann erscheinen hier neue Werte." visibility="help_view_3" />
      <info label="Zu jeder gewählten Größe siehst du einen Live-Wert (den zuletzt empfangenen Messwert) und darunter ein Diagramm über die Zeit." visibility="help_view_3" />
      <info label="Nicht ausgewählte Größen bleiben ausgeblendet und erhalten keine neuen Messwerte." visibility="help_view_3" />
      <info label="DATENQUALITÄT UND ZEIT" visibility="help_view_3" bold="true" color="orange" />
      <info label="Nach jedem START wird für die bisherigen Umweltkanäle das erste passende Paket übersprungen; IR und Bewegungskanäle behalten dieses Paket." visibility="help_view_3" />
      <info label="Spätere Einschwingvorgänge sind weiterhin möglich. Das Überspringen ist keine Kalibrierung." visibility="help_view_3" />
      <info label="Die X-Achse zeigt geschätzte Sekunden seit Experimentbeginn. Messpausen erscheinen als Lücken." visibility="help_view_3" />
      <value label="Externe Temperatursonde" unit="°C" precision="2" color="orange" visibility="sel_probe">
        <input>probe</input>
      </value>
      <graph label="Externe Temperatursonde" labelX="Zeit" labelY="Externe Temperatursonde" unitY="°C" partialUpdate="false" visibility="sel_probe" unitX="s" timeOnX="true">
        <input axis="x">t_probe</input>
        <input axis="y" color="orange">probe</input>
      </graph>
      <value label="Interne Temperatur" unit="°C" precision="2" color="orange" visibility="sel_temp">
        <input>temp</input>
      </value>
      <graph label="Interne Temperatur" labelX="Zeit" labelY="Interne Temperatur" unitY="°C" partialUpdate="false" visibility="sel_temp" unitX="s" timeOnX="true">
        <input axis="x">t_temp</input>
        <input axis="y" color="orange">temp</input>
      </graph>
      <value label="Barometrischer Druck" unit="hPa" precision="2" color="orange" visibility="sel_press">
        <input>pressure_hpa</input>
      </value>
      <graph label="Barometrischer Druck" labelX="Zeit" labelY="Barometrischer Druck" unitY="hPa" partialUpdate="false" visibility="sel_press" unitX="s" timeOnX="true">
        <input axis="x">t_press</input>
        <input axis="y" color="orange">pressure_hpa</input>
      </graph>
      <value label="Luftfeuchtigkeit" unit="%" precision="2" color="orange" visibility="sel_hum">
        <input>humidity</input>
      </value>
      <graph label="Luftfeuchtigkeit" labelX="Zeit" labelY="Luftfeuchtigkeit" unitY="%" partialUpdate="false" visibility="sel_hum" unitX="s" timeOnX="true">
        <input axis="x">t_hum</input>
        <input axis="y" color="orange">humidity</input>
      </graph>
      <value label="Hitzeindex" unit="°C" precision="2" color="orange" visibility="sel_heat">
        <input>heat</input>
      </value>
      <graph label="Hitzeindex" labelX="Zeit" labelY="Hitzeindex" unitY="°C" partialUpdate="false" visibility="sel_heat" unitX="s" timeOnX="true">
        <input axis="x">t_heat</input>
        <input axis="y" color="orange">heat</input>
      </graph>
      <value label="Umgebungslichtintensität" unit="lx" precision="2" color="orange" visibility="sel_light">
        <input>light</input>
      </value>
      <graph label="Umgebungslichtintensität" labelX="Zeit" labelY="Umgebungslichtintensität" unitY="lx" partialUpdate="false" visibility="sel_light" unitX="s" timeOnX="true">
        <input axis="x">t_light</input>
        <input axis="y" color="orange">light</input>
      </graph>
      <graph label="IR-Entfernung" labelX="Zeit" labelY="IR-Entfernung" unitX="s" unitY="m" timeOnX="true" partialUpdate="false" visibility="sel_ir" scaleMinY="fixed" scaleMaxY="fixed" minY="0" maxY="6">
        <input axis="x">t_ir</input>
        <input axis="y">ir</input>
      </graph>
      <value label="IR-Entfernung" unit="m" precision="3" visibility="sel_ir">
        <input>ir</input>
      </value>
    </view>
    <view label="Status">
      <toggle label="ⓘ Hilfe anzeigen" default="0">
        <output>help_view_4</output>
      </toggle>
      <info label="STATUS: WAS BEDEUTEN DIE ZAHLEN?" visibility="help_view_4" bold="true" color="orange" />
      <info label="„Letzte Aktion“: 1 steht für START, 0 für STOPP, −1 für noch keinen Befehl. Diese Anzeige bestätigt den Tastendruck, nicht die Antwort des Sensors." visibility="help_view_4" />
      <info label="„Ausgewählte Datenkanäle“ zählt einzelne Zahlenkanäle; Beschleunigung, Gyroskop und Magnetfeld belegen jeweils drei, die Umweltgrößen jeweils einen." visibility="help_view_4" />
      <info label="„Erwartete Float32-Werte/Paket“ zeigt die für die ausgewählte Sensorkombination erwartete Anzahl. „Empfangene Float32-Werte/Paket“ hilft bei der Paketanalyse." visibility="help_view_4" />
      <info label="„Startfilter“ zeigt, ob das erste Umweltpaket registriert wurde. Die Sample-Zähler zeigen, wie viele Messwerte bisher für eine Größe angekommen sind." visibility="help_view_4" />
      <info label="PROBLEME BEHEBEN" visibility="help_view_4" bold="true" color="orange" />
      <info label="KEINE KURVE?" visibility="help_view_4" bold="true" />
      <info label="1. Prüfe die Bluetooth-Verbindung zum richtigen Voyager 2." visibility="help_view_4" />
      <info label="2. Wähle mindestens einen Sensor; starte danach ▶ oben rechts." visibility="help_view_4" />
      <info label="3. Beide Startvorgänge ausführen: empfohlen ▶, dann „Messdaten STARTEN“. Diesen Ablauf auch beim Wiederaufnehmen nach einer Pause verwenden." visibility="help_view_4" />
      <separator height="0.7" visibility="help_view_4" />
      <info label="BLUETOOTH-VERBINDUNG ABGEBROCHEN?" visibility="help_view_4" bold="true" />
      <info label="1. Aktiviere Bluetooth am Smartphone erneut." visibility="help_view_4" />
      <info label="2. Warte, bis phyphox den Voyager 2 wieder verbunden hat." visibility="help_view_4" />
      <info label="3. Falls pausiert: empfohlen ▶ oben rechts starten und danach erneut „Messdaten STARTEN“ antippen." visibility="help_view_4" />
      <separator height="0.7" visibility="help_view_4" />
      <info label="KEINE VERBINDUNG ZUM SENSOR?" visibility="help_view_4" bold="true" />
      <info label="1. Stelle sicher, dass der Voyager 2 eingeschaltet ist." visibility="help_view_4" />
      <info label="2. Trenne eine aktive Verbindung mit PocketLab oder einer anderen Bluetooth-App." visibility="help_view_4" />
      <info label="3. Öffne das phyphox-Experiment bei Bedarf neu." visibility="help_view_4" />
      <separator height="0.7" visibility="help_view_4" />
      <info label="UNERWARTETE ODER EXTREME MESSWERTE?" visibility="help_view_4" bold="true" />
      <info label="Prüfe zuerst, ob die richtige Messgröße aktiviert ist." visibility="help_view_4" />
      <info label="Beim Wechsel der Sensoren werden alte BLE-Pakete verworfen. Einzelne Einschwingwerte können dennoch auftreten." visibility="help_view_4" />
      <separator height="0.7" visibility="help_view_4" />
      <info label="„NaN“ IM CSV-EXPORT?" visibility="help_view_4" bold="true" />
      <info label="NaN bedeutet „Not a Number“. Insbesondere werden unterschiedlich lange Datenreihen in der gemeinsamen CSV-Tabelle mit NaN aufgefüllt." visibility="help_view_4" />
      <info label="NaN ist nicht gleich null und nicht automatisch ein Sensordefekt. Es kann auch einen fehlenden oder ungültigen Zahlenwert kennzeichnen; nicht ungeprüft durch null ersetzen." visibility="help_view_4" />
      <info label="Jede Messgröße hat eine separate Zeitspalte. Gleiche Zeilennummern bedeuten bei unterschiedlich langen Datenreihen nicht automatisch denselben Messzeitpunkt." visibility="help_view_4" />
      <info label="ZEIT- UND EINHEITENHINWEIS" visibility="help_view_4" bold="true" color="orange" />
      <info label="Die Zeitwerte sind aus BLE-Empfangszeiten angenähert und monotonisiert. Unterbrechungen werden nicht mit erfundenen Werten aufgefüllt. Für präzise Timing-Experimente ist diese Schätzung nicht als Gerätezeit zu verwenden." visibility="help_view_4" />
      <info label="Die Anzeige nutzt überwiegend SI-Einheiten. Beschleunigung wurde aus g in m/s² und Winkelgeschwindigkeit aus °/s in rad/s umgerechnet." visibility="help_view_4" />
      <value label="Letzte Aktion: 1=Start, 0=Stopp" precision="0">
        <input>last_action</input>
      </value>
      <value label="Ausgewählte Datenkanäle" precision="0">
        <input>num_channels</input>
      </value>
      <value label="Erwartete Float32-Werte/Paket" precision="0">
        <input>expected_words</input>
      </value>
      <value label="Startfilter: 0=wartet, 1=erstes Paket erkannt" precision="0">
        <input>warmup_count_after</input>
      </value>
      <value label="Empfangene Float32-Werte/Paket" precision="0">
        <input>packet_word_count</input>
      </value>
      <value label="Werte Beschleunigung" precision="0">
        <input>num_acc</input>
      </value>
      <value label="Werte Winkelgeschwindigkeit" precision="0">
        <input>num_gyro</input>
      </value>
      <value label="Werte Magnetfeld" precision="0">
        <input>num_mag</input>
      </value>
      <value label="Werte Externe Temperatursonde" precision="0">
        <input>num_probe</input>
      </value>
      <value label="Werte Interne Temperatur" precision="0">
        <input>num_temp</input>
      </value>
      <info label="IR-ENTFERNUNG: v0.9.7" visibility="help_view_4" />
      <info label="Die Zehnfach-Integration wurde am 19.11.2026 getestet; der bisherige Kandidat bestand am 21.11.2026 beide Direktimporte, Messung/START/STOPP/Wiederverbindung/CSV und den Import aller zwölf Offline-Codes samt Messung. Nach dieser Textkorrektur sind die neuen Dateien und Codes erneut zu importieren." visibility="help_view_4" />
      <info label="Herstellerangabe: 0,001–6,0 m. Die feste y-Achse zeigt 0–6 m; außerhalb liegende Rohwerte bleiben in Wertanzeige und CSV erhalten. Negative Werte und etwa 8,191 m sind nicht als Fehlercodes bestätigt." visibility="help_view_4" />
      <info label="IR behält das erste passende Paket. Der bisherige Startfilter bleibt nur für die bisherigen Umweltkanäle aktiv. Keine Kalibrierung oder Glättung." visibility="help_view_4" />
      <info label="IR und Licht wurden mit verändertem Wandabstand und einer Taschenlampe unabhängig qualitativ geprüft. Beide reagierten passend; dies ist keine quantitative Kalibrierung." visibility="help_view_4" />
      <info label="Bis zu acht Notifications je Analysezyklus werden in Reihenfolge verarbeitet; weitere bleiben vorgemerkt. Vor dem Pausieren nach STOPP auf den Pufferzähler achten." visibility="help_view_4" />
      <info label="Stapel mit abweichendem Header oder inkonsistenter Gesamtwortzahl werden verworfen. Der Diagnosezähler zählt die betroffenen Notifications, nicht nachgewiesene Funkverluste." visibility="help_view_4" />
      <info label="Die Wortzähler beziehen sich auf den letzten Arbeitsschritt und können trotz Messwertempfang null anzeigen. Prüfe zusätzlich die Messwertanzahl und vorgemerkte Notifications." visibility="help_view_4" />
      <value label="IR-Messwerte im Puffer" precision="0">
        <input>num_ir</input>
      </value>
      <value label="Vorgemerkte Notifications" precision="0">
        <input>pending_packet_count</input>
      </value>
      <value label="Verworfene Notifications (Stapelprüfung)" precision="0">
        <input>dropped_total</input>
      </value>
    </view>
  </views>
  <export>
    <set name="Voyager 2 – Alle Messwerte (16 Kanäle, v0.9.7)">
      <data name="Beschleunigung – Zeit (s, geschätzt)">t_acc</data>
      <data name="Beschleunigung X (m/s²)">ax</data>
      <data name="Beschleunigung Y (m/s²)">ay</data>
      <data name="Beschleunigung Z (m/s²)">az</data>
      <data name="Winkelgeschwindigkeit – Zeit (s, geschätzt)">t_gyro</data>
      <data name="Winkelgeschwindigkeit X (rad/s)">wx</data>
      <data name="Winkelgeschwindigkeit Y (rad/s)">wy</data>
      <data name="Winkelgeschwindigkeit Z (rad/s)">wz</data>
      <data name="Magnetfeld – Zeit (s, geschätzt)">t_mag</data>
      <data name="Magnetfeld X (µT)">bx</data>
      <data name="Magnetfeld Y (µT)">by</data>
      <data name="Magnetfeld Z (µT)">bz</data>
      <data name="Interne Temperatur – Zeit (s, geschätzt)">t_temp</data>
      <data name="Interne Temperatur (°C)">temp</data>
      <data name="Barometrischer Druck – Zeit (s, geschätzt)">t_press</data>
      <data name="Barometrischer Druck (Pa)">press</data>
      <data name="Luftfeuchtigkeit – Zeit (s, geschätzt)">t_hum</data>
      <data name="Luftfeuchtigkeit (%)">humidity</data>
      <data name="Hitzeindex – Zeit (s, geschätzt)">t_heat</data>
      <data name="Hitzeindex (°C)">heat</data>
      <data name="Umgebungslichtintensität – Zeit (s, geschätzt)">t_light</data>
      <data name="Umgebungslichtintensität (lx)">light</data>
      <data name="Externe Temperatursonde – Zeit (s, geschätzt)">t_probe</data>
      <data name="Externe Temperatursonde (°C)">probe</data>
      <data name="IR-Entfernung – Zeit (s, geschätzt)">t_ir</data>
      <data name="IR-Entfernung (m)">ir</data>
    </set>
  </export>
</phyphox>
