      <string original="Interne Temperatur – Zeit (s, geschätzt)">Internal Temperature – Time (s, estimated)</string>
      <string original="Letzte Aktion: 1=Start, 0=Stopp">Last action: 1=Start, 0=Stop</string>
      <string original="Luftfeuchtigkeit">Humidity</string>
      <string original="Luftfeuchtigkeit (%)">Humidity (%)</string>
      <string original="Luftfeuchtigkeit – Zeit (s, geschätzt)">Humidity – Time (s, estimated)</string>
      <string original="MESSUNG STEUERN">CONTROL MEASUREMENT</string>
      <string original="Magnetfeld">Magnetic Field</string>
      <string original="Magnetfeld X">Magnetic Field X</string>
      <string original="Magnetfeld X (µT)">Magnetic Field X (µT)</string>
      <string original="Magnetfeld Y">Magnetic Field Y</string>
      <string original="Magnetfeld Y (µT)">Magnetic Field Y (µT)</string>
      <string original="Magnetfeld Z">Magnetic Field Z</string>
      <string original="Magnetfeld Z (µT)">Magnetic Field Z (µT)</string>
      <string original="Magnetfeld – Zeit (s, geschätzt)">Magnetic Field – Time (s, estimated)</string>
      <string original="Messdaten STARTEN">START DATA</string>
      <string original="Messdaten STOPPEN">STOP DATA</string>
      <string original="Sensorauswahl">Sensor Selection</string>
      <string original="Startfilter: 0=wartet, 1=erstes Paket erkannt">Start filter: 0=waiting, 1=first packet seen</string>
      <string original="UMGEBUNG">WEATHER</string>
      <string original="Umgebung">Weather</string>
      <string original="Umgebungslichtintensität">Ambient Light Intensity</string>
      <string original="Umgebungslichtintensität (lx)">Ambient Light Intensity (lx)</string>
      <string original="Umgebungslichtintensität – Zeit (s, geschätzt)">Ambient Light Intensity – Time (s, estimated)</string>
      <string original="Werte Beschleunigung">Acceleration samples</string>
      <string original="Werte Interne Temperatur">Internal Temperature samples</string>
      <string original="Werte Magnetfeld">Magnetic Field samples</string>
      <string original="Werte Winkelgeschwindigkeit">Angular Velocity samples</string>
      <string original="Winkelgeschwindigkeit">Angular Velocity</string>
      <string original="Winkelgeschwindigkeit X">Angular Velocity X</string>
      <string original="Winkelgeschwindigkeit Y">Angular Velocity Y</string>
      <string original="Winkelgeschwindigkeit Z">Angular Velocity Z</string>
      <string original="Winkelgeschwindigkeit – Zeit (s, geschätzt)">Angular Velocity – Time (s, estimated)</string>
      <string original="Zeit">Time</string>
      <string original="ⓘ Hilfe anzeigen">ⓘ Show help</string>
      <string original="1  VORBEREITEN">1  PREPARE</string>
      <string original="2  MESSGRÖSSEN AUSWÄHLEN">2  SELECT QUANTITIES</string>
      <string original="6  BEENDEN">6  FINISH</string>
      <string original="EINHEITEN UND UMRECHNUNG">UNITS AND CONVERSIONS</string>
      <string original="ZEITACHSE">TIME AXIS</string>
      <string original="UMGEBUNG: MESSGRÖSSEN UND EINHEITEN">WEATHER: QUANTITIES AND UNITS</string>
      <string original="DATENQUALITÄT UND ZEIT">DATA QUALITY AND TIME</string>
      <string original="STATUS: WAS BEDEUTEN DIE ZAHLEN?">STATUS: WHAT DO THESE NUMBERS MEAN?</string>
      <string original="„Letzte Aktion“: 1 steht für START, 0 für STOPP, −1 für noch keinen Befehl. Diese Anzeige bestätigt den Tastendruck, nicht die Antwort des Sensors.">“Last action”: 1 means START, 0 means STOP and −1 means no command yet. It confirms the button action, not a response from the sensor.</string>
      <string original="„Ausgewählte Datenkanäle“ zählt einzelne Zahlenkanäle; Beschleunigung, Gyroskop und Magnetfeld belegen jeweils drei, die Umweltgrößen jeweils einen.">“Selected data channels” counts scalar channels: acceleration, gyroscope and magnetic field use three each, and environment quantities use one each.</string>
      <string original="„Erwartete Float32-Werte/Paket“ zeigt die für die ausgewählte Sensorkombination erwartete Anzahl. „Empfangene Float32-Werte/Paket“ hilft bei der Paketanalyse.">“Expected float32 values/packet” shows the expected count for the selected sensor combination. “Received float32 values/packet” helps diagnose data packets.</string>
      <string original="„Startfilter“ zeigt, ob das erste Umweltpaket registriert wurde. Die Sample-Zähler zeigen, wie viele Messwerte bisher für eine Größe angekommen sind.">“Start filter” indicates whether the first environment packet has been seen. Sample counters show how many values were collected for a given quantity.</string>
      <string original="PROBLEME BEHEBEN">TROUBLESHOOTING</string>
      <string original="ZEIT- UND EINHEITENHINWEIS">TIMING AND UNIT NOTES</string>
      <string original="Die Zeitwerte sind aus BLE-Empfangszeiten angenähert und monotonisiert. Unterbrechungen werden nicht mit erfundenen Werten aufgefüllt. Für präzise Timing-Experimente ist diese Schätzung nicht als Gerätezeit zu verwenden.">Timestamps are estimated from BLE reception and kept monotonic. Gaps are not filled with invented values. This estimate is not a hardware clock suitable for precision timing experiments.</string>
      <string original="Die Anzeige nutzt überwiegend SI-Einheiten. Beschleunigung wurde aus g in m/s² und Winkelgeschwindigkeit aus °/s in rad/s umgerechnet.">The display mainly uses SI units. Acceleration is converted from g to m/s² and angular velocity from °/s to rad/s.</string>
      <string original="MESSANLEITUNG">HOW TO MEASURE</string>
      <string original="Schalte den Voyager 2 ein und aktiviere Bluetooth am Smartphone.">Switch on Voyager 2 and enable Bluetooth on your phone.</string>
      <string original="Trenne die Verbindung in PocketLab oder anderen Apps, falls sie bereits auf den Sensor zugreifen.">Disconnect PocketLab or other apps if they are already using the sensor.</string>
      <string original="Öffne dieses Experiment in phyphox und verbinde den Voyager 2 über Bluetooth. Bei nummerierten Geräten den passenden Namen „PL Voyager 2-01“ oder „PL Voyager 2-02“ wählen.">Open this experiment in phyphox and connect Voyager 2 over Bluetooth. For numbered devices, select the correct name, such as “PL Voyager 2-01” or “PL Voyager 2-02”.</string>
      <string original="3  PHYPHOX-AUFZEICHNUNG AKTIVIEREN">3  ENABLE PHYPHOX RECORDING</string>
      <string original="Nach der Sensorauswahl: Tippe oben rechts auf ▶. Damit startest du die phyphox-Aufzeichnung.">After selecting sensors, tap ▶ at the top right to start recording in phyphox.</string>
      <string original="Bei jedem Messstart und Wiederaufnehmen empfehlen wir zuerst ▶, danach „Messdaten STARTEN“.">For every measurement start and resumption, we recommend ▶ first, then START DATA.</string>
      <string original="Aktiviere die gewünschten Messgrößen mit den Kippschaltern. Mehrere Größen können gleichzeitig gemessen werden.">Enable the quantities you need using the switches. Multiple quantities can be measured at once.</string>
      <string original="Bewegungssensoren liefern X-, Y- und Z-Komponenten; Umweltgrößen liefern jeweils einen Wert.">Motion sensors provide X, Y and Z components; each weather quantity provides one value.</string>
      <string original="4  DATENEMPFANG STARTEN">4  START DATA</string>
      <string original="Empfohlener Ablauf: nach ▶ oben rechts „Messdaten STARTEN“ antippen. Diesen Ablauf auch nach einer Pause verwenden.">Recommended procedure: tap ▶ at the top right, then START DATA. Use this procedure after a pause as well.</string>
      <string original="Die Live-Werte und Diagramme findest du in den Reitern „Bewegung“ und „Umgebung“.">Live values and graphs appear in the “Motion” and “Weather” tabs.</string>
      <string original="5  MESSEN ODER AUSWAHL ÄNDERN">5  MEASURE OR CHANGE SELECTION</string>
      <string original="Du kannst zwischen den Reitern wechseln, ohne die Aufzeichnung zu unterbrechen.">You can switch tabs without interrupting recording.</string>
      <string original="Empfohlener Sensorwechsel: „Messdaten STOPPEN“, neue Sensoren auswählen, wieder „Messdaten STARTEN“. Die phyphox-Aufzeichnung dabei aktiv lassen; falls pausiert, auch wieder ▶ starten.">Recommended sensor change: “STOP DATA”, select new sensors, then “START DATA”. Leave phyphox recording active; if paused, also restart ▶.</string>
      <string original="Bereits gespeicherte Messwerte bleiben dabei erhalten.">Previously recorded samples are retained.</string>
      <string original="Zum Beenden erst „Messdaten STOPPEN“ antippen, danach phyphox oben rechts pausieren.">To finish, tap “STOP DATA” first, then pause phyphox at the top right.</string>
      <string original="⋮ → Daten exportieren → CSV → speichern/teilen.">⋮ → Export data → CSV → save/share.</string>
      <string original="Das Papierkorb-Symbol löscht deine Messwerte. Verwende es erst nach erfolgreichem Export.">The trash icon deletes the recorded data. Only use it after successfully exporting.</string>
      <string original="WICHTIG: ZWEI UNTERSCHIEDLICHE STEUERUNGEN">IMPORTANT: TWO SEPARATE CONTROLS</string>
      <string original="▶/Pause oben: startet oder pausiert die phyphox-Aufzeichnung.">Top ▶/Pause: starts or pauses recording in phyphox.</string>
      <string original="„Messdaten STARTEN/STOPPEN“: startet oder stoppt den Voyager-Datenstrom über Bluetooth.">“START DATA/STOP DATA”: starts or stops the Voyager Bluetooth data stream.</string>
      <string original="STARTEN vor ▶ funktionierte beim erstmaligen Messstart, nach dem Pausieren und Wiederaufnehmen jedoch nicht zuverlässig. Die Ursache ist nicht abschließend geklärt. Deshalb empfehlen wir immer ▶ → „Messdaten STARTEN“.">START DATA before ▶ worked for the first measurement, but was not reliable after pausing and resuming. The cause has not been conclusively established. We therefore always recommend ▶ → START DATA.</string>
      <string original="Nach einer Bluetooth-Unterbrechung auf die Wiederverbindung warten. Falls phyphox pausiert ist, empfehlen wir ▶ oben rechts und danach erneut „Messdaten STARTEN“.">After a Bluetooth interruption, wait for reconnection. If phyphox is paused, we recommend ▶ at the top right followed by “START DATA” again.</string>
      <string original="BEWEGUNG: MESSGRÖSSEN UND EINHEITEN">MOTION: QUANTITIES AND UNITS</string>
      <string original="Beschleunigung (Acceleration):">Acceleration:</string>
      <string original="X-, Y- und Z-Komponente in m/s². Der Beschleunigungssensor misst spezifische Kraft. Im Ruhezustand zeigt die nach oben gerichtete Achse typischerweise etwa +9,81 m/s².">X, Y and Z components in m/s². The accelerometer measures specific force. At rest, the upward-facing axis typically reads about +9.81 m/s².</string>
      <string original="Winkelgeschwindigkeit (Angular Velocity):">Angular Velocity:</string>
      <string original="X-, Y- und Z-Komponente in rad/s. Das Vorzeichen einer Drehung folgt der Rechte-Hand-Regel.">X, Y and Z components in rad/s. The sign of rotation follows the right-hand rule.</string>
      <string original="Magnetfeld (Magnetic Field):">Magnetic Field:</string>
      <string original="Magnetische Flussdichte entlang X, Y und Z in µT. Die Komponenten hängen von der Orientierung des Sensors im Magnetfeld ab.">Magnetic flux density along X, Y and Z in µT. The components depend on the sensor’s orientation in the magnetic field.</string>
      <string original="KOORDINATENSYSTEM UND FARBEN">COORDINATES AND COLORS</string>
      <string original="Die Pfeile auf der LED-Seite definieren die Achsen. Mit den Pfeilen aufrecht: +X nach rechts, +Y nach oben und +Z senkrecht aus der LED-Seite heraus.">The arrows printed on the LED face define the axes. With the arrows upright: +X points right, +Y points up, and +Z points outward from the LED face.</string>
      <string original="In allen XYZ-Diagrammen gilt: X = Rot, Y = Blau, Z = Grün.">In every XYZ plot: X = red, Y = blue, Z = green.</string>
      <string original="Negative Werte kennzeichnen die entgegengesetzte Achsen- beziehungsweise Drehrichtung.">Negative readings indicate the opposite axis or rotation direction.</string>
      <string original="Anzeige und CSV-Export verwenden m/s² und rad/s. Die ursprünglichen BLE-Werte liegen in g₀ und °/s vor.">The display and CSV export use m/s² and rad/s. The original BLE values are given in g₀ and °/s.</string>
      <string original="1 g₀ = 9,80665 m/s².">1 g₀ = 9.80665 m/s².</string>
      <string original="1 °/s = π/180 rad/s ≈ 0,0174533 rad/s. 1 µT = 10⁻⁶ T.">1 °/s = π/180 rad/s ≈ 0.0174533 rad/s. 1 µT = 10⁻⁶ T.</string>
      <string original="Die X-Achse zeigt die geschätzte Zeit in Sekunden seit dem Experimentstart. Grundlage sind Bluetooth-Empfangszeiten und eine angenommene Datenrate von etwa 20 Hz.">The X axis shows estimated seconds since the experiment began. It is based on Bluetooth reception times and an assumed sample rate of about 20 Hz.</string>
      <string original="Messpausen bleiben als Lücken sichtbar. Die Zeitwerte sind keine Zeitstempel aus dem Sensor.">Recording gaps remain visible. These times are not timestamps from the sensor hardware.</string>
      <string original="Interne Temperatur (Internal Temperature):">Internal Temperature:</string>
      <string original="Gemessen in °C. Der Sensor erfasst die Temperatur im Gerät; sie muss nicht der Raumtemperatur entsprechen.">Measured in °C. The sensor measures temperature inside the device; it may differ from room temperature.</string>
      <string original="Barometrischer Druck (Pressure Barometric):">Pressure Barometric:</string>
      <string original="Angezeigt in hPa und als Pa exportiert. 1 hPa = 100 Pa.">Displayed in hPa and exported in Pa. 1 hPa = 100 Pa.</string>
      <string original="Luftfeuchtigkeit (Humidity):">Humidity:</string>
      <string original="Gemessen als relative Luftfeuchtigkeit in %. 40 % bedeutet 40 % relative Feuchte, nicht 40 % Wasserdampfanteil am Luftvolumen.">Measured as relative humidity in %. A reading of 40 % means 40 % relative humidity, not 40 % water vapour by volume.</string>
      <string original="Hitzeindex (Heat Index):">Heat Index:</string>
      <string original="Angegeben in °C. Der Hitzeindex ist ein aus Umgebungsbedingungen abgeleiteter Wert, kein weiterer direkter Temperatursensor.">Expressed in °C. Heat Index is a quantity derived from environmental conditions, not an additional direct temperature sensor.</string>
      <string original="Umgebungslichtintensität (Ambient Light Intensity):">Ambient Light Intensity:</string>
      <string original="Gemessen in lx (Lux). Der Messwert beschreibt die am Sensor auftreffende Beleuchtungsstärke.">Measured in lx (lux). This quantity describes the illuminance incident on the sensor.</string>
      <string original="MESSWERTE LESEN">READING THE MEASUREMENTS</string>
      <string original="Umweltgröße unter „Sensorauswahl“ wählen, ▶ oben rechts starten und danach „Messdaten STARTEN“ antippen. Dann erscheinen hier neue Werte.">Select a weather quantity under “Sensor Selection”, start ▶ at the top right, then tap “START DATA” to receive new values here.</string>
      <string original="Zu jeder gewählten Größe siehst du einen Live-Wert (den zuletzt empfangenen Messwert) und darunter ein Diagramm über die Zeit.">For each selected quantity you see a live number (the latest received sample) and a graph showing its values over time.</string>
      <string original="Nicht ausgewählte Größen bleiben ausgeblendet und erhalten keine neuen Messwerte.">Unselected quantities stay hidden and receive no new samples.</string>
      <string original="Nach jedem START wird das erste vollständige Umwelt-Datenpaket übersprungen, weil frühere Versuche einzelne unplausible Anfangswerte zeigten.">After each START, the first complete environmental-data packet is skipped because earlier tests showed occasional implausible initial readings.</string>
      <string original="Spätere Einschwingvorgänge sind weiterhin möglich. Das Überspringen ist keine Kalibrierung.">Further settling transients are still possible. Skipping the first packet is not a calibration.</string>
      <string original="Die X-Achse zeigt geschätzte Sekunden seit Experimentbeginn. Messpausen erscheinen als Lücken.">The X axis shows estimated seconds since the experiment began. Pauses appear as gaps.</string>
      <string original="KEINE KURVE?">NO GRAPH?</string>
      <string original="1. Prüfe die Bluetooth-Verbindung zum richtigen Voyager 2.">1. Check the Bluetooth connection to the correct Voyager 2.</string>
      <string original="2. Wähle mindestens einen Sensor; starte danach ▶ oben rechts.">2. Select at least one sensor, then tap ▶ at the top right.</string>
      <string original="3. Beide Startvorgänge ausführen: empfohlen ▶, dann „Messdaten STARTEN“. Diesen Ablauf auch beim Wiederaufnehmen nach einer Pause verwenden.">3. Perform both start actions: recommended ▶, then START DATA. Use this procedure when resuming after a pause as well.</string>
      <string original="BLUETOOTH-VERBINDUNG ABGEBROCHEN?">BLUETOOTH DISCONNECTED?</string>
      <string original="1. Aktiviere Bluetooth am Smartphone erneut.">1. Re-enable Bluetooth on your phone.</string>
      <string original="2. Warte, bis phyphox den Voyager 2 wieder verbunden hat.">2. Wait for phyphox to reconnect to Voyager 2.</string>
      <string original="3. Falls pausiert: empfohlen ▶ oben rechts starten und danach erneut „Messdaten STARTEN“ antippen.">3. If paused: recommended ▶ at the top right, then tap “START DATA” again.</string>
      <string original="KEINE VERBINDUNG ZUM SENSOR?">NO CONNECTION TO THE SENSOR?</string>
      <string original="1. Stelle sicher, dass der Voyager 2 eingeschaltet ist.">1. Check that Voyager 2 is switched on.</string>
      <string original="2. Trenne eine aktive Verbindung mit PocketLab oder einer anderen Bluetooth-App.">2. Disconnect PocketLab or any other Bluetooth app connected to the sensor.</string>
      <string original="3. Öffne das phyphox-Experiment bei Bedarf neu.">3. Reopen the phyphox experiment if necessary.</string>
      <string original="UNERWARTETE ODER EXTREME MESSWERTE?">UNEXPECTED OR EXTREME READINGS?</string>
      <string original="Prüfe zuerst, ob die richtige Messgröße aktiviert ist.">First check that the correct measurement quantity is selected.</string>
      <string original="Beim Wechsel der Sensoren werden alte BLE-Pakete verworfen. Einzelne Einschwingwerte können dennoch auftreten.">Old BLE packets are rejected when changing sensors. Short settling transients can still occur.</string>
      <string original="„NaN“ IM CSV-EXPORT?">“NaN” IN THE CSV EXPORT?</string>
      <string original="NaN bedeutet „Not a Number“. Insbesondere werden unterschiedlich lange Datenreihen in der gemeinsamen CSV-Tabelle mit NaN aufgefüllt.">NaN means “Not a Number”. In particular, shorter data series are padded with NaN in the shared CSV table.</string>
      <string original="Jede Messgröße hat eine separate Zeitspalte. Gleiche Zeilennummern bedeuten bei unterschiedlich langen Datenreihen nicht automatisch denselben Messzeitpunkt.">Each measurement quantity has a separate time column. Matching row numbers do not automatically mean matching timestamps for series of different lengths.</string>
      <string original="Externe Temperatursonde">External Temperature Probe</string>
      <string original="Externe Temperatursonde (°C)">External Temperature Probe (°C)</string>
      <string original="Externe Temperatursonde – Zeit (s, geschätzt)">External Temperature Probe – Time (s, estimated)</string>
      <string original="Werte Externe Temperatursonde">External Temperature Probe samples</string>
      <string original="Externe Temperatursonde (Temperature Probe):">External Temperature Probe:</string>
      <string original="Die externe Sonde muss am Voyager 2 angeschlossen sein. Die Anzeige erfolgt in °C. Eine Kalibrierung mit einer Referenztemperatur steht noch aus.">The external probe must be connected to the Voyager 2. Values are shown in °C. Calibration against a reference thermometer is still pending.</string>
      <string original="Empfohlen: Sensoren wählen → Aufzeichnung mit ▶ (oben rechts) starten → „Messdaten STARTEN“.">Recommended: Select sensors → Start recording with ▶ (top right) → START DATA.</string>
      <string original="7  EXPORTIEREN">7  EXPORT</string>
      <string original="NaN ist nicht gleich null und nicht automatisch ein Sensordefekt. Es kann auch einen fehlenden oder ungültigen Zahlenwert kennzeichnen; nicht ungeprüft durch null ersetzen.">NaN is not zero and does not automatically indicate a faulty sensor. It may also indicate a missing or invalid numeric value; do not replace it with zero without checking.</string>
      <string original="IR-ENTFERNUNG: v0.9.7">IR RANGEFINDER: v0.9.7</string>
      <string original="Die Zehnfach-Integration wurde am 19.11.2026 getestet; der bisherige Kandidat bestand am 21.11.2026 beide Direktimporte, Messung/START/STOPP/Wiederverbindung/CSV und den Import aller zwölf Offline-Codes samt Messung. Nach dieser Textkorrektur sind die neuen Dateien und Codes erneut zu importieren.">The ten-quantity integration was tested on 19 November 2026. On 21 November, the previous candidate passed both direct imports, measurement/START/STOP/reconnection/CSV, and import of all twelve offline codes followed by a measurement. After this text correction, the new files and codes require another import test.</string>
      <string original="Herstellerangabe: 0,001–6,0 m. Die feste y-Achse zeigt 0–6 m; außerhalb liegende Rohwerte bleiben in Wertanzeige und CSV erhalten. Negative Werte und etwa 8,191 m sind nicht als Fehlercodes bestätigt.">Manufacturer-specified range: 0.001–6.0 m. The fixed y-axis displays 0–6 m; raw values outside it remain in the value display and CSV. Negative values and about 8.191 m are not confirmed error codes.</string>
      <string original="IR behält das erste passende Paket. Der bisherige Startfilter bleibt nur für die bisherigen Umweltkanäle aktiv. Keine Kalibrierung oder Glättung.">IR retains the first matching packet. The existing startup filter still applies only to the existing weather channels. No calibration or smoothing.</string>
      <string original="IR und Licht wurden mit verändertem Wandabstand und einer Taschenlampe unabhängig qualitativ geprüft. Beide reagierten passend; dies ist keine quantitative Kalibrierung.">IR and light were independently checked by changing wall distance and using a flashlight. Both responded appropriately; this is not a quantitative calibration.</string>
      <string original="Bis zu acht Notifications je Analysezyklus werden in Reihenfolge verarbeitet; weitere bleiben vorgemerkt. Vor dem Pausieren nach STOPP auf den Pufferzähler achten.">Up to eight notifications per analysis cycle are processed in order; further packets remain pending. Check the backlog after STOP before pausing.</string>
      <string original="Stapel mit abweichendem Header oder inkonsistenter Gesamtwortzahl werden verworfen. Der Diagnosezähler zählt die betroffenen Notifications, nicht nachgewiesene Funkverluste.">Batches with mismatching headers or inconsistent total word counts are discarded. The diagnostic counter counts affected notifications, not proven radio losses.</string>
      <string original="IR-Entfernung">IR Rangefinder</string>
      <string original="IR-Entfernung (m)">IR Rangefinder (m)</string>
      <string original="IR-Entfernung – Zeit (s, geschätzt)">IR Rangefinder – Time (s, estimated)</string>
      <string original="IR-Messwerte im Puffer">IR readings in buffer</string>
      <string original="Vorgemerkte Notifications">Pending notifications</string>
      <string original="Verworfene Notifications (Stapelprüfung)">Discarded notifications (batch validation)</string>
      <string original="Voyager 2 – Alle Messwerte (16 Kanäle, v0.9.7)">Voyager 2 – All readings (16 channels, v0.9.7)</string>
      <string original="Nach jedem START wird für die bisherigen Umweltkanäle das erste passende Paket übersprungen; IR und Bewegungskanäle behalten dieses Paket.">After each START, the existing weather channels skip the first matching packet; IR and motion channels retain it.</string>
      <string original="Die Wortzähler beziehen sich auf den letzten Arbeitsschritt und können trotz Messwertempfang null anzeigen. Prüfe zusätzlich die Messwertanzahl und vorgemerkte Notifications.">Word counters refer to the last processing slot and may show zero despite received readings. Also check sample counts and pending notifications.</string>
      <string original="Status">Status</string>
      <string original="Beschleunigung X (m/s²)">Acceleration X (m/s²)</string>
      <string original="Beschleunigung Y (m/s²)">Acceleration Y (m/s²)</string>
      <string original="Beschleunigung Z (m/s²)">Acceleration Z (m/s²)</string>
      <string original="Winkelgeschwindigkeit X (rad/s)">Angular velocity X (rad/s)</string>
      <string original="Winkelgeschwindigkeit Y (rad/s)">Angular velocity Y (rad/s)</string>
      <string original="Winkelgeschwindigkeit Z (rad/s)">Angular velocity Z (rad/s)</string>
    </translation>
  </translations>
